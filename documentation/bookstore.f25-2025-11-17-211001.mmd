classDiagram
    Product <|-- Ticket
    Product <|-- Publication
    Publication <|-- Book
    Publication <|-- Magazine
    Magazine <|-- DiscMag
    SaleableItem <|.. Product
    Serializable <|.. Product
    Cart "0..*" --> "0..*" Product : contains
    Order "0..*" --> "0..*" Product : contains

    class Product{
        -String productId
        -Long id
        +double price

        +getPrice()
    }

    class Serializable{
        <<interface>>
    }

    class Ticket{
        +description

        +sellItem()
    }

    class Publication{
        <<Abstract>>
        -String title
        -int copies

        +Publication()
        +Publication(String title, double price, int copies)
        +toString()
        +equals()
        +hashCode()
    }

    class Book{
        -String isbn
        -String author

        +Book()
        +Book(String author)
        +Book(String author, String title, double price, int copies)
        +toString()
        +equals()
        +hashCode()
    }

    class Magazine{
        -int orderQty
        -java.util.Date currentIssue

        +Magazine()
        +Magazine(int orderQty, Date currentIssue, String title, double price, int copies)
    }

    class DiscMag{
        -boolean hasDisc

        +DiscMag()
        +DiscMag(boolean hasDisc, int orderQty, Date currentIssue, String title, double price, int copies)
    }

    class SaleableItem {
        <<interface>>
        +sellItem()
        +getPrice()
    }

    class Cart{
        -List~Product~ items

        +Cart()
        +Cart(List~Product~ items)
        +addItem(Product item)
        +getItems()
        +setItems(List~Product~ items)
        +toString()
        +equals()
        +hashCode()
    }

    class Order{
        -double totalAmount
        -LocalDateTime orderDate
        -List~Product~ products

        +Order()
        +Order(double totalAmount, LocalDateTime orderDate, List~Product~ products)
        +addProduct(Product product)
        +getTotalAmount()
        +setTotalAmount(double totalAmount)
        +getOrderDate()
        +setOrderDate(LocalDateTime orderDate)
        +getProducts()
        +setProducts(List~Product~ products)
        +toString()
        +equals()
        +hashCode()
    }
